<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
    <PluginOutput>../../src/SentinelHUD/bin/Release/</PluginOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SentinelHUD.Core/SentinelHUD.Core.csproj" />
    <Compile Include="../../src/SentinelHUD/UI/ModernWindowPresentation.cs" Link="Consumer/ModernWindowPresentation.cs" />
    <Reference Include="SentinelCore" HintPath="$(PluginOutput)SentinelCore.dll" Private="true" />
    <Reference Include="SentinelCore.UI" HintPath="$(PluginOutput)SentinelCore.UI.dll" Private="true" />
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)Dalamud.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" Private="true" />
    <None Include="$(DalamudLibPath)cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
